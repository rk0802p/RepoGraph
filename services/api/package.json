{
  "name": "api",
  "version": "0.1.0",
  "description": "RepoGraph REST API Service",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test src/tests/**/*.test.ts tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repograph/shared-types": "*",
    "@sengac/tree-sitter-typescript": "^0.25.15",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "tree-sitter": "^0.25.1",
    "tree-sitter-javascript": "^0.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "tree-sitter@0.25.1": true,
    "tree-sitter-javascript@0.25.0": true,
    "esbuild@0.28.2": true
  }
}
